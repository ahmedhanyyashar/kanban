{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main",
    "lint": "prisma generate && eslint . --max-warnings 0",
    "check-types": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation-express": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-nestjs-core": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "helmet": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/instrumentation": "catalog:",
    "@nestjs/throttler": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "prisma": "catalog:",
    "dotenv": "catalog:",
    "@types/pg": "catalog:"
  }
}
