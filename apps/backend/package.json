{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main",
    "lint": "prisma generate && eslint . --max-warnings 0",
    "check-types": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "test:e2e": "prisma generate && vitest run --config vitest.config.e2e.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "export:openapi": "node --env-file=.env.example dist/export-openapi"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation-express": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-nestjs-core": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "ai": "catalog:",
    "helmet": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:",
    "@repo/shared": "workspace:*",
    "@prisma/client": "catalog:",
    "pg": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/instrumentation": "catalog:",
    "better-auth": "catalog:",
    "@thallesp/nestjs-better-auth": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/websockets": "catalog:",
    "socket.io": "catalog:",
    "prisma": "catalog:",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "socket.io-client": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
