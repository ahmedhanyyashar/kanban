{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "*.config.ts",
    "*.config.mts",
    "*.config.e2e.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
